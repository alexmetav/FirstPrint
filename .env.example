PORT=8787
DB_PATH=./data/firstprint.db
PUBLIC_URL=http://localhost:8787
# Reverse proxies in front of the app: 1 on Render/Vercel/behind Cloudflare, 0 locally.
# Required in production. At 0 behind a proxy, all visitors share one rate-limit bucket.
TRUST_PROXY=0
# Static root. Unset serves web/ (app only). Set to ./.deploy after `npm run build:live`
# to serve the marketing site at / and the live app at /play from this same origin.
WEB_DIR=
# Run npm run setup to generate a private admin key for local use.
ADMIN_KEY=
SIM=0
SOLANA_CHAIN=devnet
TRACK_VENUES=binance,okx,bybit
AUTO_CREATE_MARKETS=0
TRACK_EVERY_MS=120000
# Optional server-side CoinGecko demo key. Never put it in frontend config.
COINGECKO_API_KEY=
