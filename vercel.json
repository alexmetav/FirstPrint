{
  "buildCommand": "npm run build:deploy",
  "outputDirectory": ".deploy",
  "rewrites": [
    {
      "source": "/api/market-data",
      "destination": "https://firstprint-demo-api.onrender.com/api/market-data"
    },
    {
      "source": "/api/:path*",
      "destination": "https://firstprint-app.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "APP_URL": "/app/"
    }
  }
}
