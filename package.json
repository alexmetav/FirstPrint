{
  "name": "firstprint",
  "version": "0.1.0",
  "private": true,
  "description": "Firstprint: predict how new exchange listings trade in their first 72 hours. Solana wallet sign-in, live exchange data, on-chain pools.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:deploy": "npm run build:web && node scripts/build-deploy.ts",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.ts",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.ts",
    "check": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/check-exchanges.ts",
    "live": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/live-markets.ts",
    "build:site": "node --disable-warning=ExperimentalWarning scripts/build-site.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
