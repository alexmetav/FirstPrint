PORT=8787
DB_PATH=./data/firstprint.db
PUBLIC_URL=http://localhost:8787
# Run npm run setup to generate a private admin key for local use.
ADMIN_KEY=
SIM=0
SOLANA_CHAIN=devnet
# 1 (default): admins create, publish and settle markets from the admin panel. The server still checks
# MEXC every 2 minutes for new USDT pairs and queues them in Admin → New listings (see AUTO_LISTINGS).
# Set 0 for the full seven-exchange scanner with self-settling markets and live prices.
MANUAL_ONLY=1
# New MEXC listings when MANUAL_ONLY=1: review (default, admin reviews each one), publish (opens
# self-settling markets by itself), or 0 (off).
# AUTO_LISTINGS=review
# AUTO_MARKETS_PER_DAY=5
# AUTO_MARKET_HOURS=72
TRACK_EVERY_MS=120000
# Only used when MANUAL_ONLY=0: which exchanges the scanner watches (default: all seven) and
# whether detections open markets by themselves.
# TRACK_VENUES=binance,mexc,bybit,okx,gate,bitget,kucoin
# AUTO_CREATE_MARKETS=0
# Telegram bot token from @BotFather: admin alerts and posts to the player channel (set both up in
# Admin → Settings). Secret.
TELEGRAM_BOT_TOKEN=
# SITE=0 serves only the app (no landing page at /). NODE_ENV=production on the live server.
# Sign-in. Google: create an OAuth "Web" client ID at console.cloud.google.com and add your site
# as an authorized JavaScript origin. Only the client ID is needed (it is public).
GOOGLE_CLIENT_ID=
# Email codes: a Resend API key and a sender on a domain you verified there. Without these,
# email sign-in is only available outside production (the code is printed in the server log).
RESEND_API_KEY=
MAIL_FROM=
# Database backup for hosts without a persistent disk (Render free plan). Supabase project URL and its
# service_role key (secret). Without them the database is only a local file.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Proxies in front of the server (Render's load balancer = 1; add one for Vercel rewrites). Used to tell visitors
# apart for rate limits. Default: 1 in production, 0 otherwise (an empty value also means the default).
# TRUST_PROXY_HOPS=1
# TestFPT: players claim points to their wallets as a token on a Solana test network (testnet or devnet).
# Set it up from the admin panel; these override it. SOLANA_RPC_URL defaults to the public RPC.
TOKEN_CLUSTER=testnet
# TESTFPT_AUTHORITY_KEY=
# TESTFPT_MINT=
# SOLANA_RPC_URL=
