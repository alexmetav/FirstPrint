{
  "buildCommand": "npm run build:deploy",
  "outputDirectory": ".deploy",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "https://firstprint-demo-api.onrender.com/api/health"
    },
    {
      "source": "/api/market-data",
      "destination": "https://firstprint-demo-api.onrender.com/api/market-data"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
