PORT=8787
DB_PATH=./data/firstprint.db
PUBLIC_URL=http://localhost:8787
# Run npm run setup to generate a private admin key for local use.
ADMIN_KEY=
SIM=0
SOLANA_CHAIN=devnet
TRACK_VENUES=binance,okx,bybit
AUTO_CREATE_MARKETS=0
TRACK_EVERY_MS=120000
# 1 (default): admins create, publish and settle every market from the admin panel;
# no exchange scanning or live price feeds. Set 0 to turn the automatic tracker back on.
MANUAL_ONLY=1
# Sign-in. Google: create an OAuth "Web" client ID at console.cloud.google.com and add your site
# as an authorized JavaScript origin. Only the client ID is needed (it is public).
GOOGLE_CLIENT_ID=
# Email codes: a Resend API key and a sender on a domain you verified there. Without these,
# email sign-in is only available outside production (the code is printed in the server log).
RESEND_API_KEY=
MAIL_FROM=
# Database backup for hosts without a persistent disk (Render free plan). Supabase project URL and its
# service_role key (secret). Without them the database is only a local file.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Proxies in front of the server (Render's load balancer = 1; add one for Vercel rewrites). Used to tell visitors
# apart for rate limits. Default: 1 in production, 0 otherwise (an empty value also means the default).
# TRUST_PROXY_HOPS=1
